<Application x:Class="ScanDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScanDesk"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Palette -->
        <SolidColorBrush x:Key="Bg" Color="#EEF2FA"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ink" Color="#1E293B"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Sky" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="Violet" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="Teal" Color="#0D9488"/>
        <SolidColorBrush x:Key="Amber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="Orange" Color="#F97316"/>
        <SolidColorBrush x:Key="Pink" Color="#EC4899"/>
        <SolidColorBrush x:Key="Green" Color="#16A34A"/>
        <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
        <SolidColorBrush x:Key="Rose" Color="#E11D48"/>
        <SolidColorBrush x:Key="Slate" Color="#475569"/>
        <SolidColorBrush x:Key="Indigo" Color="#4F46E5"/>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#9333EA" Offset="0.45"/>
            <GradientStop Color="#EC4899" Offset="0.8"/>
            <GradientStop Color="#F97316" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ScanGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22C55E" Offset="0"/>
            <GradientStop Color="#0D9488" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#4F46E5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ClearGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FB7185" Offset="0"/>
            <GradientStop Color="#E11D48" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="StopGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#EA580C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F43F5E" Offset="0"/>
            <GradientStop Color="#F59E0B" Offset="0.35"/>
            <GradientStop Color="#22C55E" Offset="0.65"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#1E293B"/>
        <DropShadowEffect x:Key="HoverShadow" BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.28" Color="#1E293B"/>

        <!-- Card container -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18,14,18,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Big selectable tile: used for RadioButtons (choose one) and ToggleButtons (on/off) -->
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="16" BorderThickness="2.5"
                                    Background="#F8FAFC"
                                    BorderBrush="{Binding (local:Ui.Accent), RelativeSource={RelativeSource TemplatedParent}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,10">
                                    <TextBlock x:Name="ic" FontFamily="{StaticResource IconFont}" FontSize="28"
                                               HorizontalAlignment="Center"
                                               Text="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{Binding (local:Ui.Accent), RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ContentPresenter x:Name="cp" Margin="0,7,0,0" HorizontalAlignment="Center"
                                                      TextElement.FontSize="15" TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{StaticResource Ink}"/>
                                    <TextBlock x:Name="sub" HorizontalAlignment="Center" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                                               Text="{Binding (local:Ui.Subtitle), RelativeSource={RelativeSource TemplatedParent}}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="check" Width="24" Height="24" CornerRadius="12" Background="White"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding (local:Ui.Accent), RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect" Value="{StaticResource HoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{Binding (local:Ui.Accent), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="ic" Property="Foreground" Value="White"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                                <Setter TargetName="sub" Property="Foreground" Value="#E6FFFFFF"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Large filled action button -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="MinHeight" Value="84"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="20" Effect="{StaticResource SoftShadow}"
                                    Background="{Binding (local:Ui.Accent), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="hl" CornerRadius="20" Background="White" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,8">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="30" FontWeight="Normal" VerticalAlignment="Center"
                                           Text="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <ContentPresenter/>
                                    <TextBlock x:Name="sub" FontSize="12.5" FontWeight="Normal" Opacity="0.9"
                                               Text="{Binding (local:Ui.Subtitle), RelativeSource={RelativeSource TemplatedParent}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hl" Property="Opacity" Value="0.14"/>
                                <Setter TargetName="bd" Property="Effect" Value="{StaticResource HoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="local:Ui.Subtitle" Value="">
                                <Setter TargetName="sub" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smaller pill button (Browse, Rotate, etc.) -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" BorderThickness="2" Background="#F8FAFC" Padding="{TemplateBinding Padding}"
                                BorderBrush="{Binding (local:Ui.Accent), RelativeSource={RelativeSource TemplatedParent}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="ic" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center"
                                           Foreground="{Binding (local:Ui.Accent), RelativeSource={RelativeSource TemplatedParent}}"
                                           Text="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="cp" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{StaticResource Ink}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{Binding (local:Ui.Accent), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="ic" Property="Foreground" Value="White"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BigTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource Line}" Background="#F8FAFC" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Violet}"/>
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
