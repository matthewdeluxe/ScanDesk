<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyTitle>ScanDesk</AssemblyTitle>
    <Product>ScanDesk</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ScanDesk.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Description>Scan documents from a WIA or TWAIN scanner to searchable PDFs.</Description>
    <!-- Keep publish output small: ship English resources only. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ScanDesk.ico" />
    <Resource Include="Assets\ScanDesk.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAPS2.Images.Wpf" Version="1.6.1" />
    <PackageReference Include="NAPS2.Sdk" Version="1.6.1" />
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="1.6.1" />
    <PackageReference Include="NAPS2.Tesseract.Binaries" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
