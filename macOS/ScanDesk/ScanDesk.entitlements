<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: ScanDesk saves straight into a folder you pick (default ~/Documents/Scans),
	     like the Windows version. Hardened runtime is on so the app can be notarized. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
