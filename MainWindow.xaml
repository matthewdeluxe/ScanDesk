<Window x:Class="ScanDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScanDesk"
        Title="ScanDesk" Width="1380" Height="900" MinWidth="1150" MinHeight="740"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="pack://application:,,,/Assets/ScanDesk.ico"
        FontFamily="{StaticResource UiFont}" Background="{StaticResource Bg}"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="60" Height="60" CornerRadius="18" Background="#40FFFFFF" Padding="2">
                    <Image Source="pack://application:,,,/Assets/ScanDesk.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ScanDesk" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Feed it, scan it, file it — searchable PDFs in one click" FontSize="14" Foreground="#E6FFFFFF"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" FontSize="22" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DeviceBox" Width="360" Height="44" FontSize="15" VerticalContentAlignment="Center"
                              Padding="12,0" SelectionChanged="DeviceBox_SelectionChanged"/>
                    <Button x:Name="RefreshBtn" Style="{StaticResource PillButton}" local:Ui.Icon="&#xE72C;"
                            local:Ui.Accent="{StaticResource Indigo}" Margin="10,0,0,0" MinHeight="44"
                            Click="Refresh_Click" ToolTip="Look for scanners again">
                        <TextBlock Text="Refresh"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1" Margin="20,18,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Settings column -->
            <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                <StackPanel Margin="0,0,0,10">

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Sides"/>
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="OneSided" GroupName="Sides" Style="{StaticResource Tile}"
                                             local:Ui.Icon="&#xE7C3;" local:Ui.Accent="{StaticResource Sky}"
                                             local:Ui.Subtitle="Front only">One-Sided</RadioButton>
                                <RadioButton x:Name="TwoSided" GroupName="Sides" Style="{StaticResource Tile}"
                                             local:Ui.Icon="&#xE8C8;" local:Ui.Accent="{StaticResource Sky}"
                                             local:Ui.Subtitle="Front and back">Two-Sided</RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Color"/>
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="ColorMode" GroupName="Color" Style="{StaticResource Tile}"
                                             local:Ui.Icon="&#xE790;" local:Ui.Accent="{StaticResource Pink}"
                                             local:Ui.Subtitle="Photos, forms">Color</RadioButton>
                                <RadioButton x:Name="GrayMode" GroupName="Color" Style="{StaticResource Tile}"
                                             local:Ui.Icon="&#xE706;" local:Ui.Accent="{StaticResource Violet}"
                                             local:Ui.Subtitle="Shades of gray">Grayscale</RadioButton>
                                <RadioButton x:Name="BwMode" GroupName="Color" Style="{StaticResource Tile}"
                                             local:Ui.Icon="&#xE8D2;" local:Ui.Accent="{StaticResource Slate}"
                                             local:Ui.Subtitle="Text, smallest file">Black &amp; White</RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Resolution &amp; paper"/>
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="Dpi200" GroupName="Dpi" Style="{StaticResource Tile}" MinHeight="78"
                                             local:Ui.Icon="&#xE8B9;" local:Ui.Accent="{StaticResource Teal}"
                                             local:Ui.Subtitle="Fast">200 dpi</RadioButton>
                                <RadioButton x:Name="Dpi300" GroupName="Dpi" Style="{StaticResource Tile}" MinHeight="78"
                                             local:Ui.Icon="&#xE8B9;" local:Ui.Accent="{StaticResource Teal}"
                                             local:Ui.Subtitle="Recommended">300 dpi</RadioButton>
                                <RadioButton x:Name="Dpi600" GroupName="Dpi" Style="{StaticResource Tile}" MinHeight="78"
                                             local:Ui.Icon="&#xE8B9;" local:Ui.Accent="{StaticResource Teal}"
                                             local:Ui.Subtitle="Fine detail">600 dpi</RadioButton>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="Letter" GroupName="Paper" Style="{StaticResource Tile}" MinHeight="70"
                                             local:Ui.Icon="&#xE7C3;" local:Ui.Accent="{StaticResource Blue}"
                                             local:Ui.Subtitle="8.5 × 11 in">Letter</RadioButton>
                                <RadioButton x:Name="Legal" GroupName="Paper" Style="{StaticResource Tile}" MinHeight="70"
                                             local:Ui.Icon="&#xE8A5;" local:Ui.Accent="{StaticResource Blue}"
                                             local:Ui.Subtitle="8.5 × 14 in">Legal</RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Clean up  (click to turn on/off)"/>
                            <UniformGrid Columns="3">
                                <ToggleButton x:Name="SkipBlank" Style="{StaticResource Tile}"
                                              local:Ui.Icon="&#xE894;" local:Ui.Accent="{StaticResource Orange}"
                                              local:Ui.Subtitle="Drop empty backs">Skip Blanks</ToggleButton>
                                <ToggleButton x:Name="Deskew" Style="{StaticResource Tile}"
                                              local:Ui.Icon="&#xE7AD;" local:Ui.Accent="{StaticResource Amber}"
                                              local:Ui.Subtitle="Fix crooked pages">Straighten</ToggleButton>
                                <ToggleButton x:Name="Ocr" Style="{StaticResource Tile}"
                                              local:Ui.Icon="&#xE721;" local:Ui.Accent="{StaticResource Green}"
                                              local:Ui.Subtitle="Searchable text">OCR</ToggleButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Work column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Action buttons -->
                <Grid Margin="-6,-6,-6,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ScanBtn" Style="{StaticResource BigButton}" MinHeight="104" FontSize="28"
                            local:Ui.Icon="&#xE8FE;" local:Ui.Accent="{StaticResource ScanGradient}"
                            local:Ui.Subtitle="Scan everything in the feeder" Click="Scan_Click">SCAN</Button>
                    <Button x:Name="StopBtn" Style="{StaticResource BigButton}" MinHeight="104" FontSize="28" Visibility="Collapsed"
                            local:Ui.Icon="&#xE71A;" local:Ui.Accent="{StaticResource StopGradient}"
                            local:Ui.Subtitle="Cancel the current scan" Click="Stop_Click">STOP</Button>
                    <Button x:Name="SaveBtn" Grid.Column="1" Style="{StaticResource BigButton}" MinHeight="104"
                            local:Ui.Icon="&#xEA90;" local:Ui.Accent="{StaticResource SaveGradient}"
                            local:Ui.Subtitle="Make the PDF" Click="Save_Click">Save PDF</Button>
                    <Button x:Name="ClearBtn" Grid.Column="2" Style="{StaticResource BigButton}" MinHeight="104"
                            local:Ui.Icon="&#xE74D;" local:Ui.Accent="{StaticResource ClearGradient}"
                            local:Ui.Subtitle="Start over" Click="Clear_Click">Clear</Button>
                </Grid>

                <!-- Save location -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Save to"/>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Folder" Width="80" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="FolderBox" Grid.Column="1" Style="{StaticResource BigTextBox}"/>
                            <Button Grid.Column="2" Style="{StaticResource PillButton}" local:Ui.Icon="&#xE8B7;"
                                    local:Ui.Accent="{StaticResource Violet}" Click="Browse_Click">Browse…</Button>
                            <Button Grid.Column="3" Style="{StaticResource PillButton}" local:Ui.Icon="&#xE838;"
                                    local:Ui.Accent="{StaticResource Indigo}" Click="OpenFolder_Click">Open</Button>
                        </Grid>
                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="File name" Width="80" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource BigTextBox}"
                                     ToolTip="Leave blank to name the file by date and time"/>
                            <TextBlock Grid.Column="2" Text=".pdf" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <ToggleButton x:Name="AutoSave" Style="{StaticResource Tile}" MinHeight="48" Width="150" Margin="4"
                                              local:Ui.Icon="&#xE74E;" local:Ui.Accent="{StaticResource Blue}"
                                              ToolTip="Save the PDF automatically as soon as the feeder is empty">Auto-save</ToggleButton>
                                <ToggleButton x:Name="OpenAfter" Style="{StaticResource Tile}" MinHeight="48" Width="150" Margin="4"
                                              local:Ui.Icon="&#xE8E5;" local:Ui.Accent="{StaticResource Indigo}"
                                              ToolTip="Open the PDF after saving it">Open after</ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Pages -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PagesTitle" Style="{StaticResource CardTitle}" Text="Pages" Margin="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="MoveLeftBtn" Style="{StaticResource PillButton}" local:Ui.Icon="&#xE76B;"
                                        local:Ui.Accent="{StaticResource Sky}" Click="MoveLeft_Click" ToolTip="Move page earlier">Earlier</Button>
                                <Button x:Name="MoveRightBtn" Style="{StaticResource PillButton}" local:Ui.Icon="&#xE76C;"
                                        local:Ui.Accent="{StaticResource Sky}" Click="MoveRight_Click" ToolTip="Move page later">Later</Button>
                                <Button x:Name="RotateLeftBtn" Style="{StaticResource PillButton}" local:Ui.Icon="&#xE7AD;"
                                        local:Ui.Accent="{StaticResource Amber}" Click="RotateLeft_Click">Rotate ⟲</Button>
                                <Button x:Name="RotateRightBtn" Style="{StaticResource PillButton}" local:Ui.Icon="&#xE7AD;"
                                        local:Ui.Accent="{StaticResource Amber}" Click="RotateRight_Click">Rotate ⟳</Button>
                                <Button x:Name="DeletePageBtn" Style="{StaticResource PillButton}" local:Ui.Icon="&#xE74D;"
                                        local:Ui.Accent="{StaticResource Rose}" Click="DeletePage_Click">Delete page</Button>
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="PageList" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0" Background="Transparent"
                                 SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="PageList_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" CornerRadius="14" BorderThickness="3" BorderBrush="Transparent"
                                                        Background="#F1F5F9" Padding="8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#E0E7FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#8B5CF6"/>
                                                        <Setter TargetName="bd" Property="Background" Value="#EDE9FE"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PageItem}">
                                    <StackPanel Width="170">
                                        <Border Height="200" Background="White" CornerRadius="6">
                                            <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.LayoutTransform>
                                                    <RotateTransform Angle="{Binding Rotation}"/>
                                                </Image.LayoutTransform>
                                            </Image>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}">
                                            <Run Text="Page "/><Run Text="{Binding Number, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" FontSize="64" HorizontalAlignment="Center"
                                       Foreground="#C7D2FE"/>
                            <TextBlock Text="Put your pages face-up in the document feeder" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                            <TextBlock Text="then press the green SCAN button. Scan again to add more pages to the same PDF."
                                       FontSize="14.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0" FontSize="15" Foreground="{StaticResource Ink}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ready"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenLastBtn" Style="{StaticResource PillButton}" MinHeight="40" Visibility="Collapsed"
                            local:Ui.Icon="&#xE8E5;" local:Ui.Accent="{StaticResource Blue}" Click="OpenLast_Click">Open last PDF</Button>
                    <ProgressBar x:Name="Progress" Width="260" Height="10" Margin="12,0,0,0" Visibility="Collapsed"
                                 Foreground="#8B5CF6" Background="#EDE9FE" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
